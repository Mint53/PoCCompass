# Server-side only (never NEXT_PUBLIC_). Copy to .env.local for local development.
BACKEND_URL=http://localhost:7072/api
# Azure only: Functions host key (stored in Key Vault, injected as app setting)
BACKEND_FUNCTION_KEY=
# Local only: identity used when App Service authentication headers are absent
DEV_USER_EMAIL=dev.user@example.com
DEV_USER_NAME=開発ユーザー
